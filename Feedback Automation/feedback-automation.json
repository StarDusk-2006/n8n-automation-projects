{
  "name": "Customer Feedback Automation",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.feedback }}",
        "options": {
          "systemMessage": "You are a professional customer feedback analysis agent.\n\nYour task is to analyze customer feedback and determine its sentiment.\n\nAnalyze the feedback based on:\n1. Customer satisfaction.\n2. Positive or negative experiences.\n3. Complaints and suggestions.\n4. Overall tone and emotional context.\n\nCLASSIFICATION RULES:\n\nAssign a sentiment score between -100 and +100.\n\n- Good: Scores from +20 to +100.\n- Neutral: Scores from -19 to +19.\n- Bad: Scores from -100 to -20.\n\nScoring guidelines:\n- +80 to +100: Extremely positive feedback.\n- +50 to +79: Strongly positive feedback.\n- +20 to +49: Mildly positive feedback.\n- -19 to +19: Neutral or mixed feedback.\n- -20 to -49: Mildly negative feedback.\n- -50 to -79: Strongly negative feedback.\n- -80 to -100: Extremely negative feedback.\n\nIMPORTANT:\n- Do not classify feedback based on individual positive or negative words alone.\n- Consider the overall meaning and context.\n- Sarcasm and indirect complaints should be considered.\n- If feedback contains both positive and negative aspects, evaluate the overall experience.\n- Do not assume that a suggestion automatically means dissatisfaction.\n\nAlso calculate a confidence score between 0 and 100, representing how confident you are in your classification.\n\nOUTPUT REQUIREMENTS:\n\nReturn ONLY a valid JSON object.\nDo not include markdown formatting, explanations outside the JSON, or code blocks.\n\nUse exactly this structure:\n\n{\n  \"sentiment\": \"<Good | Neutral | Bad>\",\n  \"sentiment_score\": <integer from -100 to 100>,\n  \"confidence\": <integer from 0 to 100>,\n  \"reason\": \"<one short sentence explaining the classification>\"\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        432,
        0
      ],
      "id": "03a438ba-98aa-4a2d-9259-e77e382341d5",
      "name": "AI Agent1",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {
          "temperature": 0
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        432,
        176
      ],
      "id": "71bfeb1a-52fe-4a09-a0a4-68a5bba00c97",
      "name": "Groq Chat Model1"
    },
    {
      "parameters": {
        "jsCode": "// Get AI Agent response\nconst response = $input.first().json.output;\n\nif (typeof response !== \"string\" || !response.trim()) {\n    throw new Error(\"AI response is empty or not text\");\n}\n\n// Extract the JSON object even if the model adds extra text or code fences\nconst start = response.indexOf(\"{\");\nconst end = response.lastIndexOf(\"}\");\n\nif (start === -1 || end <= start) {\n    throw new Error(\"No JSON object found in AI response: \" + response.slice(0, 200));\n}\n\nlet analysis;\ntry {\n    analysis = JSON.parse(response.slice(start, end + 1));\n} catch (error) {\n    throw new Error(\"Failed to parse AI response: \" + error.message);\n}\n\n// Validate sentiment score (must exist, be numeric, and be in range)\nif (analysis.sentiment_score === null || analysis.sentiment_score === undefined || analysis.sentiment_score === \"\") {\n    throw new Error(\"Missing sentiment score\");\n}\nconst score = Number(analysis.sentiment_score);\n\nif (!Number.isFinite(score) || score < -100 || score > 100) {\n    throw new Error(\"Invalid sentiment score: \" + analysis.sentiment_score);\n}\n\n// Validate confidence\nconst confidence = Number(analysis.confidence);\nif (!Number.isFinite(confidence) || confidence < 0 || confidence > 100) {\n    throw new Error(\"Invalid confidence: \" + analysis.confidence);\n}\n\n// Determine sentiment using numerical thresholds\nlet sentiment;\n\nif (score >= 20) {\n    sentiment = \"Good\";\n} else if (score <= -20) {\n    sentiment = \"Bad\";\n} else {\n    sentiment = \"Neutral\";\n}\n\nreturn [\n    {\n        json: {\n            sentiment,\n            sentiment_score: score,\n            confidence,\n            reason: String(analysis.reason ?? \"\")\n        }\n    }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

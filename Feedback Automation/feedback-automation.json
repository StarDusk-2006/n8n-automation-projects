        "message": "=<!DOCTYPE html> <html> <head> <style>     body {         font-family: Arial, sans-serif;         background-color: #f4f6f8;         margin: 0;         padding: 30px;     }      .container {         max-width: 600px;         margin: auto;         background: #ffffff;         border-radius: 12px;         overflow: hidden;     }      .header {         background: #16a34a;         color: white;         padding: 35px 20px;         text-align: center;     }      .content {         padding: 30px;         color: #333;         line-height: 1.7;     }      .badge {         background: #dcfce7;         color: #166534;         padding: 12px;         border-radius: 8px;         text-align: center;         margin: 20px 0;     }      .feedback {         background: #f9fafb;         padding: 15px;         border-left: 4px solid #16a34a;         margin: 20px 0;     }      .footer {         background: #f9fafb;         padding: 20px;         text-align: center;         color: #888;         font-size: 12px;     } </style> </head>  <body>  <div class=\"container\">      <div class=\"header\">         <h1>Thank You! 🎉</h1>         <p>We're glad you enjoyed your experience!</p>     </div>      <div class=\"content\">          <h2>Hello {{ $('Feedback :)').item.json.name || 'Valued Customer' }},</h2>          <p>             We truly appreciate you taking the time to share your experience             with us. Your satisfaction means everything to our team!         </p>          <div class=\"badge\">             <h3>Positive Feedback</h3>             <strong>Sentiment Score: {{ $('Code in JavaScript').item.json.sentiment_score }} (scale: -100 to +100)</strong>         </div>          <h3>Your Feedback:</h3>          <div class=\"feedback\">            {{ String($('Feedback :)').item.json.feedback).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}          </div>          <p>             Your kind words motivate us to keep delivering the best possible  
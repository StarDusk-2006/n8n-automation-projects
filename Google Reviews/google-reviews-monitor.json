    {
      "parameters": {
        "promptType": "define",
        "text": "=Place: {{ $json.placeName }}\nReviewer: {{ $json.reviewerName }}\nRating: {{ $json.rating }}\nReview: {{ $json.reviewText }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a customer review analyzer. Return ONLY valid JSON, no extra text, with exactly these fields:\n- review_rating: positive | negative | neutral\n- action: thank_customer | investigate_complaint | improve_service | respond_to_feedback\n- priority: high | medium | low\n\nPriority rules: high = rating 1-2 or serious complaints (hygiene, safety, rudeness); medium = rating 3 or moderate complaints; low = rating 4-5 without serious issues.\nDo not invent information or assume problems that are not mentioned.\nIMPORTANT: the star rating has the strongest influence on review_rating."
            }
          ]
        },
        "batching": {}
      },

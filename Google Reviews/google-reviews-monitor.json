      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        608,
        208
      ],
      "id": "3f4387b7-daca-45a2-bdec-ff79358774fc",
      "name": "OpenRouter Chat Model"
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI's JSON reply. If it is malformed, fall back to rules based on the star rating.\nconst fallbackFromRating = (rating) => {\n  const r = Number(rating);\n  if (!Number.isFinite(r)) return { review_rating: 'neutral', action: 'respond_to_feedback', priority: 'medium' };\n  if (r <= 2) return { review_rating: 'negative', action: 'investigate_complaint', priority: 'high' };\n  if (r === 3) return { review_rating: 'neutral', action: 'respond_to_feedback', priority: 'medium' };\n  return { review_rating: 'positive', action: 'thank_customer', priority: 'low' };\n};\n\nreturn $input.all().map((item, i) => {\n  const src = $('Edit Fields').itemMatching(i).json;\n  let ai;\n  try {\n    const raw = String(item.json.text ?? '');\n    const start = raw.indexOf('{');\n    const end = raw.lastIndexOf('}');\n    ai = JSON.parse(raw.slice(start, end + 1));\n  } catch (e) {\n    ai = fallbackFromRating(src.rating);\n  }\n  return { json: { ...src, ...ai } };\n});\n"
      },
